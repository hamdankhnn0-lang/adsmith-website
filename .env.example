# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pizzabox?schema=public"

# --- NextAuth -----------------------------------------------------------------
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Public app URL, used to build QR code links and OAuth redirects.
APP_URL="http://localhost:3000"

# --- Google Business Profile OAuth --------------------------------------------
# See README.md "Google Business Profile API setup" for how to obtain these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/oauth/callback"

# --- OpenAI (optional) ---------------------------------------------------------
# If unset, the app falls back to a rule-based sentiment classifier and
# template-based reply drafts. Everything works in demo mode without this.
OPENAI_API_KEY=""

# --- Security -------------------------------------------------------------------
# 64-character hex string (32 bytes) used to AES-256-GCM encrypt OAuth tokens
# at rest. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# --- One-time deploy seeding (optional) ------------------------------------------
# If set, enables POST /api/admin/seed (header x-seed-secret: <value>) to seed
# demo data once on a fresh deployment where running `npm run db:seed` locally
# isn't convenient (e.g. Vercel). Refuses to run if the database already has
# data. Leave unset to disable the endpoint entirely.
SEED_SECRET=""

# --- Demo mode -------------------------------------------------------------------
# Informational flag surfaced in the UI; the app auto-detects demo mode based on
# whether a Google Business Profile is connected, regardless of this value.
DEMO_MODE="true"
