# Copy to `.env` and fill in. Anything prefixed VITE_ is bundled into the
# public JavaScript, so only ever put non secret values here. A form endpoint
# URL is fine, an API key is not.

# Where the contact form posts.
# Leave empty and it posts to /contact.php, which ships in public/ and emails
# the enquiry. That is the default and needs no third party service.
# Set it to override, for example:
#
#   Formspree   https://formspree.io/f/xxxxxxxx
#   Your own    https://your-host/api/contact
#
VITE_FORM_ENDPOINT=

# How the form reaches that endpoint. Leave empty for the default, which posts
# quietly in the background and keeps the visitor on the page.
#
# Set it to `native` and the browser submits the form itself and navigates to
# the endpoint, the way HTML worked before JavaScript. Slower and uglier, and
# the only thing that works from a file opened off disk, because a background
# post from a local file is refused before it leaves the browser. That is what
# a build for testing before there is any hosting needs:
#
#   VITE_FORM_MODE=native \
#   VITE_FORM_ENDPOINT=https://formsubmit.co/you@example.com \
#     npm run build
#
VITE_FORM_MODE=

# Optional. A real scheduler link (Cal.com, Calendly). When set, the booking
# card shows one "See available times" button instead of the WhatsApp buttons.
VITE_BOOKING_URL=
